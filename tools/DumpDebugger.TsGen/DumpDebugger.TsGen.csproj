<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates web/src/contracts.gen.ts from DumpDebugger.Core's RPC catalog and contract
       records, so the web app never hand-duplicates a wire type. Run via `npm run gen:types`
       in web/. DumpDebugger.Tests fails if the checked-in file has drifted. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DumpDebugger.Core\DumpDebugger.Core.csproj" />
  </ItemGroup>

</Project>
