{
  "name": "dump-debugger-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:types": "dotnet run --project ../tools/DumpDebugger.TsGen -- src/contracts.gen.ts",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
