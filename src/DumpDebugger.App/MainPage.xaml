<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DumpDebugger_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DumpDebugger_App"
    xmlns:vm="using:DumpDebugger_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dump Debugger" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Open Dump…"
                    Command="{x:Bind ViewModel.OpenDumpCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
            <Button Content="Export Report…"
                    Command="{x:Bind ViewModel.ExportReportCommand}"
                    Visibility="{x:Bind ViewModel.HasFindings, Mode=OneWay}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Foreground="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource ErrorBrushConverter}}"
                    TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="3" Visibility="{x:Bind ViewModel.HasThreads, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="{x:Bind ViewModel.MetadataSummary, Mode=OneWay}"
                       FontFamily="Cascadia Mono"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <Pivot Grid.Row="3" Visibility="{x:Bind ViewModel.HasThreads, Mode=OneWay}">

            <PivotItem Header="Triage">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <Button Content="Explain (AI)…"
                                Command="{x:Bind ViewModel.ExplainCommand}"
                                IsEnabled="{x:Bind ViewModel.IsExplaining, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsExplaining, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Visibility="{x:Bind ViewModel.HasNarrative, Mode=OneWay}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBlock Text="{x:Bind ViewModel.NarrativeText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Border>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Findings}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingRow">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Severity}" Foreground="White" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Opacity="0.85" />
                                        <TextBlock Text="{x:Bind EvidenceText}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Overview">
                <ScrollViewer>
                    <TextBlock Text="{x:Bind ViewModel.MetadataSummary, Mode=OneWay}"
                               FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Threads">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Threads (grouped by stack)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.ThreadGroups}"
                                  SelectedItem="{x:Bind ViewModel.SelectedThreadGroup, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThreadGroupRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8" Padding="6,2" MinWidth="32">
                                            <TextBlock Text="{x:Bind Count}" HorizontalAlignment="Center" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{x:Bind TopFrame}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Stack (representative thread)" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedThreadGroup.OSThreadIds, Mode=OneWay, Converter={StaticResource ThreadIdsConverter}}"
                                       FontFamily="Cascadia Mono" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedThreadGroup.OperationContext, Mode=OneWay}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.SelectedThreadGroup.OperationContext, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedThreadGroup.FullStack, Mode=OneWay}"
                                       FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Locks &amp; Deadlocks">
                <ScrollViewer>
                    <TextBlock Text="{x:Bind ViewModel.LocksSummary, Mode=OneWay}"
                               FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Memory">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Type statistics (top 50 by total size)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TypeStats}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TypeStatRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                        <TextBlock Text="{x:Bind TotalSizeDisplay}" Width="80" />
                                        <TextBlock Text="{x:Bind Count}" Width="60" Opacity="0.7" />
                                        <TextBlock Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Large objects (identified)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.LargeObjects}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LargeObjectRow">
                                    <StackPanel Spacing="2" Padding="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind SizeDisplay}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                            <TextBlock Text="{x:Bind Address}" Opacity="0.6" FontFamily="Cascadia Mono" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Identity}" Opacity="0.8" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
