<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 window whose whole client area is a WebView2 running the React app in web/.
    It owns native concerns only: the window and titlebar, file dialogs and drag-drop, and
    the bridge into DumpDebugger.Session (worker lifecycle, workspace, recents, compare).

    Unpackaged and self-contained by default so the built exe runs directly. Pass
    -p:Packaged=true to produce an MSIX instead (see README "Package").
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DumpDebugger.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateThumbprint)' == '' and '$(PackageCertificateKeyFile)' == ''">false</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateThumbprint)' != '' or '$(PackageCertificateKeyFile)' != ''">true</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png;Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DumpDebugger.Core\DumpDebugger.Core.csproj" />
    <ProjectReference Include="..\DumpDebugger.Session\DumpDebugger.Session.csproj" />
  </ItemGroup>

  <!--
    Bundled assets, included as content so they land both next to the exe and inside an MSIX:
      web\                 the React app (web/dist; run `npm run build` in web/ first)
      Workers\win-x64|x86  the architecture-matched workers (ClrMD must match the dump's bitness)
      Tools\DumpGen        the sample generator behind Home's "Generate a sample"
    Defaults point at the dev build outputs; build/package.ps1 overrides them with
    self-contained publish folders so the package needs no .NET install.
  -->
  <PropertyGroup>
    <WebDist Condition="'$(WebDist)' == ''">$(MSBuildThisFileDirectory)..\..\web\dist</WebDist>
    <WorkerX64Dir Condition="'$(WorkerX64Dir)' == ''">$(MSBuildThisFileDirectory)..\DumpDebugger.Worker\bin\$(Configuration)\net10.0\win-x64</WorkerX64Dir>
    <WorkerX86Dir Condition="'$(WorkerX86Dir)' == ''">$(MSBuildThisFileDirectory)..\DumpDebugger.Worker\bin\$(Configuration)\net10.0\win-x86</WorkerX86Dir>
    <DumpGenDir Condition="'$(DumpGenDir)' == ''">$(MSBuildThisFileDirectory)..\DumpDebugger.DumpGen\bin\$(Configuration)\net10.0</DumpGenDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(WebDist)\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(WorkerX64Dir)\**\*" Link="Workers\win-x64\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(WorkerX86Dir)\**\*" Link="Workers\win-x86\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(DumpGenDir)\**\*" Exclude="$(DumpGenDir)\**\*.dmp" Link="Tools\DumpGen\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnMissingBundles" BeforeTargets="Build">
    <Warning Condition="!Exists('$(WebDist)\index.html')" Text="web/dist is missing; run 'npm run build' in web/ before building the host." />
    <Warning Condition="!Exists('$(WorkerX64Dir)\DumpDebugger.Worker.exe')" Text="The x64 worker isn't built; run 'dotnet build src/DumpDebugger.Worker -r win-x64'." />
    <Warning Condition="!Exists('$(WorkerX86Dir)\DumpDebugger.Worker.exe')" Text="The x86 worker isn't built; run 'dotnet build src/DumpDebugger.Worker -r win-x86'." />
  </Target>
</Project>
