<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DumpDebugger.Core\DumpDebugger.Core.csproj" />
    <ProjectReference Include="..\DumpDebugger.Analysis\DumpDebugger.Analysis.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x86;x64</Platforms>
    <!-- ClrMD must run as the same architecture as the dump it reads (PLAN.md §2.2);
         the App launches this worker as either win-x86 or win-x64 based on the dump. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
